# The UI starter runs without any environment variables.
# The two public Supabase values enable optional auth/history/settings sync.
# Other values are reserved for the future server-side pipeline.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
VISION_ENABLED=false
GOOGLE_CLOUD_CREDENTIALS=
DAILY_LIMIT=
