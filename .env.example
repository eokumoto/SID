# Copy this template to .env.local for local development.
# These two public values enable Supabase login/history/settings sync.
NEXT_PUBLIC_SUPABASE_URL=
# Use your publishable key (sb_publishable_...), despite the legacy variable name.
# Never use a secret or service-role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required server-only key for automatic email lookup. Never use NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Server-only scanning pipeline. Never expose any of these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Pin a Gemini model that supports image input and JSON output.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Set true only after GOOGLE_CLOUD_CREDENTIALS is configured. This is a service-account
# JSON document (or its base64 encoding) with Cloud Vision API access.
VISION_ENABLED=false
GOOGLE_CLOUD_CREDENTIALS=
# Per user, per UTC day; admitted attempts, including failed attempts, count.
DAILY_LIMIT=20
