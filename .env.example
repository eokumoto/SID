# Copy this template to .env.local for local development.
# These two public values enable Supabase login/history/settings sync.
NEXT_PUBLIC_SUPABASE_URL=
# Use your publishable key (sb_publishable_...), despite the legacy variable name.
# Never use a secret or service-role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required server-only key for automatic email lookup. Never use NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Server-only scanning pipeline. Never expose any of these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Pin a Gemini model that supports image input and JSON output.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Listen (Pro read-aloud). Optional: without it, Listen uses Gemini speech with GEMINI_API_KEY.
GOOGLE_TTS_API_KEY=
# Optional Gemini speech model override (default gemini-3.1-flash-tts-preview).
GEMINI_TTS_MODEL=
# Upload allowances are 10 Free / 150 Pro successful reads per UTC day.
# Defined server-side in 20261115000000_pro_features.sql; DAILY_LIMIT is retired.

# Stripe billing. Keep these server-only; use Stripe test keys locally.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring Stripe Price IDs (price_..., not product IDs).
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
